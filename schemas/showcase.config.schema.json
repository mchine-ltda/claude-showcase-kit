                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string",
                            "description": "Font file (woff2/ttf/otf), relative to this config file"
                          },
                          "weight": {
                            "default": 400,
                            "type": "number"
                          }
                        },
                        "required": [
                          "path"
                        ]
                      }
                    }
                  },
                  "required": [
                    "family"
                  ],
                  "description": "Titles and the outro call to action"
                },
                "body": {
                  "type": "object",
                  "properties": {
                    "family": {
                      "type": "string",
                      "description": "Font family. Bundled with the engine (Google Fonts, OFL): Inter Tight, Geist, Geist Mono, Instrument Serif"
                    },
                    "files": {
                      "default": [],
                      "description": "Local files for a font that is not bundled. Keep licensed files out of public repositories",
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string",
                            "description": "Font file (woff2/ttf/otf), relative to this config file"
                          },
                          "weight": {
                            "default": 400,
                            "type": "number"
                          }
                        },
                        "required": [
                          "path"
                        ]
                      }
                    }
                  },
                  "required": [
                    "family"
                  ],
                  "description": "Subtitles and small text"
                },
                "mono": {
                  "type": "object",
                  "properties": {
                    "family": {
                      "type": "string",
                      "description": "Font family. Bundled with the engine (Google Fonts, OFL): Inter Tight, Geist, Geist Mono, Instrument Serif"
                    },
                    "files": {
                      "default": [],
                      "description": "Local files for a font that is not bundled. Keep licensed files out of public repositories",
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string",
                            "description": "Font file (woff2/ttf/otf), relative to this config file"
                          },
                          "weight": {
                            "default": 400,
                            "type": "number"
                          }
                        },
                        "required": [
                          "path"
                        ]
                      }
                    }
                  },
                  "required": [
                    "family"
                  ],
                  "description": "Labels (eyebrow) when eyebrow is \"mono\""
